# Configuração opcional do prospecteezy.
# A chave do Serper pode ser salva pela tela Configurações (recomendado).
# Se preferir o arquivo, copie este modelo para ".env" e preencha.

# Chave da API do Serper.dev. A chave salva em Configurações tem prioridade.
SERPER_API_KEY=

# Porta do servidor. Padrão: 3000.
PORT=3000
