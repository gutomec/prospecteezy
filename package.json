{
  "name": "prospecteezy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente de prospecção local: busca Serper Places com cursor persistente, enriquecimento de e-mails e API REST (Bun only).",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "dev:ui": "bun --hot src/client/preview.ts",
    "dev:ui:mock": "PREVIEW_MOCK=1 bun --hot src/client/preview.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "wa:pair": "bun src/whatsapp/scripts/pair.ts",
    "wa:validate": "bun src/whatsapp/scripts/validate.ts",
    "wa:contacts": "bun src/whatsapp/scripts/contacts.ts",
    "wa:smoke-qr": "bun src/whatsapp/scripts/smoke-qr.ts",
    "notices": "bun scripts/third-party-notices.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@ai-sdk/react": "4.0.140",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@radix-ui/react-use-controllable-state": "1.3.0",
    "@tanstack/react-query": "5.104.2",
    "@types/qrcode": "^1.5.6",
    "ai": "7.0.137",
    "baileys": "7.0.0-rc13",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "nanoid": "6.0.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "streamdown": "2.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.6"
  }
}
